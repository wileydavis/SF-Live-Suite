{"title":"PERF","icon":[0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0],"selectedPreset":0,"color":34,"transmitMode":0,"pcOnEntry":0,"bankOnEntry":65535,"recentPage":0,"recentPreset":0,"transmitOnSceneEntry":0,"transmitOnPageSwitch":0,"transmitOnPresetLoad":0,"smartTransmit":15,"outputOnEntry":0,"holdMode":0,"acceleration":3,"code":{"code":"local MAP = \"---00d00e00f010011012013014015016017------f1ae1b---10d10e10f110111112113114115116117------f1ae1b---20d20e20f210211212213214215216217------f1ae1b---30d30e30f310311312313314315316317------f1ae1b---40d40e40f410411412413414415416417------f1ae1b---50d50e50f510511512513514515516517------f1ae1b---60d60e60f610611612613614615616617------f1ae1b---70d70e70f710711712713714715716717------f1ae1b---80d80e80f810811812813814815816817------f1ae1b---90d90e90f910911912913914915916917------f1ae1b---a0da0ea0fa10a11a12a13a14a15a16a17------f1ae1b---11c21c31c41c51c61c71c81c91ca1cd1cd1dd1ef1ae1b\" local GREEN = 90 local HOLD = 24 local HAND = 16 local held, hand, here, tick = {}, {}, {}, 0 local function look(pg) for i = 1, 16 do local k = ((pg - 1) * 16 + i - 1) * 3 + 1 local c = MAP:sub(k, k) here[i] = (c == \"-\") and -1 or (tonumber(c, 16) * 128 + tonumber(MAP:sub(k + 1, k + 2), 16)) end end local function free(i) if held[i] then leds.reset(i) held[i] = nil end end function controller.onSysex(b) if b[2] ~= 0x7D or b[3] ~= 0x53 or b[4] ~= 0x46 then return end local kind = b[5] local step = (kind == 1) and 4 or 2 for k = 6, #b - step, step do local a = b[k] * 128 + b[k + 1] for i = 1, 16 do if here[i] == a then if kind == 2 then free(i) elseif kind == 1 and (hand[i] or -1) < tick then leds.updateByIndex(i, b[k + 2] * 128 + b[k + 3], GREEN) held[i] = tick end end end end end function controller.onEncoderTurn(e) if e.increment ~= 0 and e.index then hand[e.index] = tick + HAND free(e.index) end end function system.update() tick = tick + 1 for i = 1, 16 do if held[i] and tick - held[i] > HOLD then free(i) end end end function page.onPageChange(prev, curr) for i = 1, 16 do free(i) end hand = {} look(curr) end function page.onInit() for i = 1, 16 do leds.reset(i) end look(controller.getPage()) system.setUpdateRate(50) end\n","fullScript":"-- SF SHOW and SF MIX: GLIDE RINGS. A knob that is travelling (SLOW, SLOW ALL) shows where its sound is now,\r\n-- in green, until it arrives; then the ring is the knob's own again. Turn a travelling knob and the\r\n-- ring shows your hand for a moment. The knobs themselves are the scene's plain CC knobs: if this\r\n-- script stops, the rings show the knobs' values as before.\r\n--\r\n-- SF CONTROL reports the travelling knobs (E16 RINGS port), as SysEx:\r\n--   F0 7D 53 46 01 {channel-1, number, value / 128, value % 128} ... F7   where the sound is (0-16383)\r\n--   F0 7D 53 46 02 {channel-1, number} ... F7                              arrived\r\n-- MAP (make_scene.py writes it from layout.py, one per scene): three characters per knob, the\r\n-- channel - 1 as one hex digit and the number as two, \"---\" for a knob that never travels: knobs\r\n-- 1-16 of page 1, then of page 2, ... page 12.\r\n-- Lua 5.4 on the E16: integers only, no clock but system.update.\r\nlocal MAP = \"---00d00e00f010011012013014015016017------f1ae1b---10d10e10f110111112113114115116117------f1ae1b---20d20e20f210211212213214215216217------f1ae1b---30d30e30f310311312313314315316317------f1ae1b---40d40e40f410411412413414415416417------f1ae1b---50d50e50f510511512513514515516517------f1ae1b---60d60e60f610611612613614615616617------f1ae1b---70d70e70f710711712713714715716717------f1ae1b---80d80e80f810811812813814815816817------f1ae1b---90d90e90f910911912913914915916917------f1ae1b---a0da0ea0fa10a11a12a13a14a15a16a17------f1ae1b---11c21c31c41c51c61c71c81c91ca1cd1cd1dd1ef1ae1b\"\r\nlocal GREEN = 90\r\nlocal HOLD = 24        -- updates (50 ms) without a report before a ring goes back: 1.2 s\r\nlocal HAND = 16        -- updates a turned knob keeps showing your hand: 0.8 s\r\nlocal held, hand, here, tick = {}, {}, {}, 0\r\n\r\n-- The addresses of the knobs on page pg, channel * 128 + number (-1: none).\r\nlocal function look(pg)\r\n  for i = 1, 16 do\r\n    local k = ((pg - 1) * 16 + i - 1) * 3 + 1\r\n    local c = MAP:sub(k, k)\r\n    here[i] = (c == \"-\") and -1 or (tonumber(c, 16) * 128 + tonumber(MAP:sub(k + 1, k + 2), 16))\r\n  end\r\nend\r\n\r\nlocal function free(i)\r\n  if held[i] then\r\n    leds.reset(i)\r\n    held[i] = nil\r\n  end\r\nend\r\n\r\nfunction controller.onSysex(b)\r\n  if b[2] ~= 0x7D or b[3] ~= 0x53 or b[4] ~= 0x46 then return end\r\n  local kind = b[5]\r\n  local step = (kind == 1) and 4 or 2\r\n  for k = 6, #b - step, step do\r\n    local a = b[k] * 128 + b[k + 1]\r\n    for i = 1, 16 do\r\n      if here[i] == a then\r\n        if kind == 2 then\r\n          free(i)\r\n        elseif kind == 1 and (hand[i] or -1) < tick then\r\n          leds.updateByIndex(i, b[k + 2] * 128 + b[k + 3], GREEN)\r\n          held[i] = tick\r\n        end\r\n      end\r\n    end\r\n  end\r\nend\r\n\r\nfunction controller.onEncoderTurn(e)\r\n  if e.increment ~= 0 and e.index then\r\n    hand[e.index] = tick + HAND\r\n    free(e.index)\r\n  end\r\nend\r\n\r\nfunction system.update()\r\n  tick = tick + 1\r\n  for i = 1, 16 do\r\n    if held[i] and tick - held[i] > HOLD then free(i) end\r\n  end\r\nend\r\n\r\nfunction page.onPageChange(prev, curr)\r\n  for i = 1, 16 do free(i) end\r\n  hand = {}\r\n  look(curr)\r\nend\r\n\r\nfunction page.onInit()\r\n  for i = 1, 16 do leds.reset(i) end\r\n  look(controller.getPage())\r\n  system.setUpdateRate(50)\r\nend\r\n","scriptName":"sf_glide_rings"},"pages":[{"title":"KCK","output":0,"channel":1,"encoders":[{"name":"TUNE","abbr":"TUNE","color":34,"push_action":{"instrument":127,"parameter":0,"type":9,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":17,"nr2":11,"output":15,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":1,"lower":0,"upper":127,"defaultValue":64,"nr1":12,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":16,"lower":0,"upper":127,"defaultValue":0,"nr1":12,"nr2":0,"output":12,"scriptId":0}],"color2":90},{"name":"PUNCH","abbr":"PNCH","color":34,"push_action":{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":2,"nr2":2,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":1,"lower":0,"upper":127,"defaultValue":64,"nr1":13,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CLICK","abbr":"CLCK","color":34,"push_action":{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":3,"nr2":3,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":1,"lower":0,"upper":127,"defaultValue":64,"nr1":14,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"DRIVE","abbr":"DRV","color":34,"push_action":{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":4,"nr2":4,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":1,"lower":0,"upper":127,"defaultValue":25,"nr1":15,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"PITCH T","abbr":"PTIM","color":34,"push_action":{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lowe