{"title":"SF SHOW","icon":[0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0,0,0,102,102,102,102,0,0],"selectedPreset":0,"color":34,"transmitMode":0,"pcOnEntry":0,"bankOnEntry":65535,"recentPage":0,"recentPreset":0,"transmitOnSceneEntry":0,"transmitOnPageSwitch":0,"transmitOnPresetLoad":0,"smartTransmit":15,"outputOnEntry":0,"holdMode":0,"acceleration":3,"code":{"code":"local MAP = \"---d1ed28e14------------714---923a18------------01401501601701a01901801b11411511611711811911a11b21421521621821921a21721b31731531641741541651751561461561661861961a61761b71471571671771871971a71b81481581681781881982781b91492392291791891991e91ba14a15a19a16a17a18a1aa1bb14b15b16b17c14c15c16c18f14f15f16f17f18f19d33d35\" local GREEN = 90 local HOLD = 24 local HAND = 16 local held, hand, here, tick = {}, {}, {}, 0 local function look(pg) for i = 1, 16 do local k = ((i <= 8) and (i - 1) or (8 + (pg - 1) * 8 + i - 9)) * 3 + 1 local c = MAP:sub(k, k) here[i] = (c == \"-\") and -1 or (tonumber(c, 16) * 128 + tonumber(MAP:sub(k + 1, k + 2), 16)) end end local function free(i) if held[i] then leds.reset(i) held[i] = nil end end function controller.onSysex(b) if b[2] ~= 0x7D or b[3] ~= 0x53 or b[4] ~= 0x46 then return end local kind = b[5] local step = (kind == 1) and 4 or 2 for k = 6, #b - step, step do local a = b[k] * 128 + b[k + 1] for i = 1, 16 do if here[i] == a then if kind == 2 then free(i) elseif kind == 1 and (hand[i] or -1) < tick then leds.updateByIndex(i, b[k + 2] * 128 + b[k + 3], GREEN) held[i] = tick end end end end end function controller.onEncoderTurn(e) if e.increment ~= 0 and e.index then hand[e.index] = tick + HAND free(e.index) end end function system.update() tick = tick + 1 for i = 1, 16 do if held[i] and tick - held[i] > HOLD then free(i) end end end function page.onPageChange(prev, curr) for i = 1, 16 do free(i) end hand = {} look(curr) end function page.onInit() for i = 1, 16 do leds.reset(i) end look(controller.getPage()) system.setUpdateRate(50) end\n","fullScript":"-- SF SHOW: GLIDE RINGS. A knob that is travelling (SLOW, SLOW ALL) shows where its sound is now,\r\n-- in green, until it arrives; then the ring is the knob's own again. Turn a travelling knob and the\r\n-- ring shows your hand for a moment. The knobs themselves are the scene's plain CC knobs: if this\r\n-- script stops, the rings show the knobs' values as before.\r\n--\r\n-- SF CONTROL reports the travelling knobs (E16 RINGS port), as SysEx:\r\n--   F0 7D 53 46 01 {channel-1, number, value / 128, value % 128} ... F7   where the sound is (0-16383)\r\n--   F0 7D 53 46 02 {channel-1, number} ... F7                              arrived\r\n-- MAP (make_scene.py writes it from layout.py): three characters per knob, the channel - 1 as one\r\n-- hex digit and the number as two, \"---\" for a knob that never travels: knobs 1-8 (the same on\r\n-- every page), then knobs 9-16 of pages 1-12.\r\n-- Lua 5.4 on the E16: integers only, no clock but system.update.\r\nlocal MAP = \"---d1ed28e14------------714---923a18------------01401501601701a01901801b11411511611711811911a11b21421521621821921a21721b31731531641741541651751561461561661861961a61761b71471571671771871971a71b81481581681781881982781b91492392291791891991e91ba14a15a19a16a17a18a1aa1bb14b15b16b17c14c15c16c18f14f15f16f17f18f19d33d35\"\r\nlocal GREEN = 90\r\nlocal HOLD = 24        -- updates (50 ms) without a report before a ring goes back: 1.2 s\r\nlocal HAND = 16        -- updates a turned knob keeps showing your hand: 0.8 s\r\nlocal held, hand, here, tick = {}, {}, {}, 0\r\n\r\n-- The addresses of the knobs on page pg, channel * 128 + number (-1: none).\r\nlocal function look(pg)\r\n  for i = 1, 16 do\r\n    local k = ((i <= 8) and (i - 1) or (8 + (pg - 1) * 8 + i - 9)) * 3 + 1\r\n    local c = MAP:sub(k, k)\r\n    here[i] = (c == \"-\") and -1 or (tonumber(c, 16) * 128 + tonumber(MAP:sub(k + 1, k + 2), 16))\r\n  end\r\nend\r\n\r\nlocal function free(i)\r\n  if held[i] then\r\n    leds.reset(i)\r\n    held[i] = nil\r\n  end\r\nend\r\n\r\nfunction controller.onSysex(b)\r\n  if b[2] ~= 0x7D or b[3] ~= 0x53 or b[4] ~= 0x46 then return end\r\n  local kind = b[5]\r\n  local step = (kind == 1) and 4 or 2\r\n  for k = 6, #b - step, step do\r\n    local a = b[k] * 128 + b[k + 1]\r\n    for i = 1, 16 do\r\n      if here[i] == a then\r\n        if kind == 2 then\r\n          free(i)\r\n        elseif kind == 1 and (hand[i] or -1) < tick then\r\n          leds.updateByIndex(i, b[k + 2] * 128 + b[k + 3], GREEN)\r\n          held[i] = tick\r\n        end\r\n      end\r\n    end\r\n  end\r\nend\r\n\r\nfunction controller.onEncoderTurn(e)\r\n  if e.increment ~= 0 and e.index then\r\n    hand[e.index] = tick + HAND\r\n    free(e.index)\r\n  end\r\nend\r\n\r\nfunction system.update()\r\n  tick = tick + 1\r\n  for i = 1, 16 do\r\n    if held[i] and tick - held[i] > HOLD then free(i) end\r\n  end\r\nend\r\n\r\nfunction page.onPageChange(prev, curr)\r\n  for i = 1, 16 do free(i) end\r\n  hand = {}\r\n  look(curr)\r\nend\r\n\r\nfunction page.onInit()\r\n  for i = 1, 16 do leds.reset(i) end\r\n  look(controller.getPage())\r\n  system.setUpdateRate(50)\r\nend\r\n","scriptName":"sf_glide_rings"},"pages":[{"title":"PERFORM","output":0,"channel":8,"encoders":[{"name":"LOW ENGY","abbr":"E LO","color":34,"push_action":{"instrument":127,"parameter":0,"type":9,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":17,"nr2":11,"output":15,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":14,"lower":0,"upper":127,"defaultValue":64,"nr1":20,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":16,"lower":0,"upper":127,"defaultValue":0,"nr1":34,"nr2":0,"output":12,"scriptId":0}],"color2":90},{"name":"DRM ENGY","abbr":"E DR","color":34,"push_action":{"instrument":127,"parameter":0,"type":0,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":2,"nr2":2,"output":0,"scriptId":0},"turn_action